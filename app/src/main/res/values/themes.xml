<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CurrencyConverter" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Основные цвета -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryVariant">@color/primary_dark_blue</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Вторичные цвета -->
        <item name="colorSecondary">@color/accent_orange</item>
        <item name="colorSecondaryVariant">@color/accent_dark_orange</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Фоновые цвета -->
        <item name="android:colorBackground">@color/dark_bg</item>
        <item name="colorSurface">@color/surface_gray</item>
        <item name="colorOnSurface">@color/white</item>

        <!-- Текст -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/light_gray</item>

        <!-- Статус бар -->
        <item name="android:statusBarColor">@color/primary_dark_blue</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>

        <!-- Навигация -->
        <item name="android:navigationBarColor">@color/dark_bg</item>

        <!-- Material 3 компоненты -->
        <item name="materialButtonStyle">@style/Widget.CurrencyConverter.Button</item>

    </style>

    <!-- Стиль для кнопок -->
    <style name="Widget.CurrencyConverter.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Стиль для TextView -->
    <style name="Widget.CurrencyConverter.TextView" parent="Widget.MaterialComponents.TextView">
        <item name="android:textColor">@color/white</item>
    </style>
</resources>